<%- include('partials_header') %>
<main class="auth-page auth-page-login">
  <section class="auth-card auth-card-large">
    <div class="auth-icon"><i class="bi bi-headset"></i></div>
    <h1>Sistema de Tickets</h1>
    <p>Faça login para acessar sua conta</p>

    <% if (erro) { %>
      <div class="alert"><%= erro %></div>
    <% } %>

    <div class="auth-divider"></div>

    <form action="/login" method="POST">
      <label>E-mail</label>
      <div class="input-with-icon">
        <i class="bi bi-envelope"></i>
        <input type="email" name="email" placeholder="seu@email.com" required>
      </div>

      <label>Senha</label>
      <div class="input-with-icon">
        <i class="bi bi-lock"></i>
        <input type="password" name="senha" placeholder="Sua senha" required>
        <i class="bi bi-eye"></i>
      </div>

      <div class="helper-link-wrap">
        <a href="#">Esqueceu sua senha?</a>
      </div>

      <button type="submit" class="button block"><i class="bi bi-box-arrow-in-right"></i>Entrar</button>
    </form>

    <div class="auth-or">ou</div>
    <p>Ainda não possui conta? <a href="/cadastro">Cadastre-se</a></p>
  </section>
</main>
<%- include('partials_footer') %>
