<%- include('partials_header') %>
<header class="auth-mini-header">
  <div class="auth-mini-brand">
    <i class="bi bi-headset"></i>
    <div>
      <strong>Sistema de Tickets</strong>
      <span>Help Desk</span>
    </div>
  </div>
  <a href="/login" class="auth-mini-back"><i class="bi bi-arrow-left"></i>Voltar para o login</a>
</header>

<main class="auth-page auth-page-register">
  <section class="auth-card auth-card-large">
    <div class="auth-icon soft"><i class="bi bi-person-plus"></i></div>
    <h1>Criar uma nova conta</h1>
    <p>Preencha os dados abaixo para se cadastrar</p>

    <% if (erro) { %>
      <div class="alert"><%= erro %></div>
    <% } %>

    <form action="/cadastro" method="POST">
      <label>Nome completo</label>
      <div class="input-with-icon">
        <i class="bi bi-person"></i>
        <input type="text" name="nome" placeholder="Digite seu nome completo" required>
      </div>

      <label>E-mail</label>
      <div class="input-with-icon">
        <i class="bi bi-envelope"></i>
        <input type="email" name="email" placeholder="Digite seu e-mail" required>
      </div>

      <label>Senha</label>
      <div class="input-with-icon">
        <i class="bi bi-lock"></i>
        <input type="password" name="senha" placeholder="Digite sua senha" required>
        <i class="bi bi-eye"></i>
      </div>

      <label>Confirmar senha</label>
      <div class="input-with-icon">
        <i class="bi bi-lock"></i>
        <input type="password" placeholder="Confirme sua senha" required>
        <i class="bi bi-eye"></i>
      </div>

      <label>Tipo de usuário</label>
      <div class="input-with-icon">
        <i class="bi bi-person-gear"></i>
        <select name="tipo">
          <option value="comum">Usuário comum</option>
          <option value="admin">Administrador</option>
        </select>
      </div>

      <button type="submit" class="button block">Cadastrar</button>
    </form>

    <div class="auth-divider"></div>
    <p>Já possui conta? <a href="/login">Fazer login</a></p>
  </section>
</main>
<%- include('partials_footer') %>
