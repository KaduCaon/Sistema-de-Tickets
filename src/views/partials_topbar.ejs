<header class="app-topbar">
  <button type="button" class="menu-button" aria-label="Abrir menu">
    <i class="bi bi-list"></i>
  </button>

  <div class="topbar-right">
    <button type="button" class="notification-button" aria-label="Notificações">
      <i class="bi bi-bell"></i>
      <span class="badge-dot">3</span>
    </button>

    <div class="topbar-user">
      <div class="topbar-avatar"><i class="bi bi-person-circle"></i></div>
      <div>
        <strong><%= usuario.nome %></strong>
        <span><%= usuario.tipo === 'admin' ? 'Administrador' : 'Usuário' %></span>
      </div>
      <i class="bi bi-chevron-down"></i>
    </div>
  </div>
</header>
